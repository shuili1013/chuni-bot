# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: set to a guild ID to register slash commands instantly to that one server
DISCORD_GUILD_ID=

# Server
PORT=8080
DATA_DIR=./data
PUBLIC_BASE_URL=https://shuili1013.github.io/chuni-bot
# Where the bookmarklet POSTs sync data — your Fly.io URL or cloudflared tunnel URL
SYNC_API_BASE=https://chuni-bot.fly.dev
